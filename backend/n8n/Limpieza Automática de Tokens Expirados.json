      "name": "Preparar Log",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Formatear mensaje de log estructurado\nconst data = $input.item.json;\nconst timestamp = new Date().toISOString();\n\nlet message = `[${timestamp}] Limpieza de tokens completada\\n`;\nmessage += `Estado: ${data.success ? 'ÉXITO' : 'ERROR'}\\n`;\n\nif (data.success && data.deleted) {\n  message += `Tokens eliminados:\\n`;\n  message += `  - Tokens revocados: ${data.deleted.revoked_tokens}\\n`;\n  message += `  - Refresh tokens: ${data.deleted.refresh_tokens}\\n`;\n  message += `  - Total: ${data.deleted.total}\\n`;\n}\n\nif (data.error) {\n  message += `Error: ${data.error}\\n`;\n}\n\nreturn {\n  json: {\n    message: message,\n    data: data,\n    timestamp: timestamp\n  }\n};"
      },
      "id": "5ad1f6f0-789f-43e1-a079-7afd645e0e24",
      "name": "Formatear Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "error-assignment",
              "name": "error",
              "value": "={{ $json.error || $json.message || 'Error desconocido' }}",
              "type": "string"
            },
            {
              "id": "timestamp-assignment",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
