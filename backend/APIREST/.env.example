# JWT Configuration
# IMPORTANT: These values MUST match the auth-microservicio configuration
# Both services use HMAC-SHA256 (HS256) algorithm for JWT signing/validation

# Shared secret key for JWT validation (same as auth-microservicio JWT_ACCESS_SECRET)
JWT_SECRET=your_shared_secret_key_here

# JWT Issuer (must be 'auth-service')
JWT_ISSUER=auth-service

# Note: This APIREST validates tokens locally using the shared secret.
# It does NOT call the auth-microservicio for each request.
# Validation includes: signature, expiration, and issuer.

# N8N Configuration
N8N_API_KEY=your_n8n_api_key_here
