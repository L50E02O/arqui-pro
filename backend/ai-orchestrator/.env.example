# ====================================
# AI Orchestrator Configuration
# ====================================

# Server Config
HOST=0.0.0.0
PORT=8001
DEBUG=true
ENVIRONMENT=development

# ====================================
# LLM Providers (al menos uno obligatorio)
# ====================================

# OpenAI (GPT-4, GPT-3.5-turbo)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_MODEL=gpt-3.5-turbo  # Más económico

# Google Gemini (Recomendado para MVP - gratis hasta cierto límite)
GEMINI_API_KEY=AIzaSyDNxeuQA5LaZoRktOW1HkTZj-yDS9ZTL9M
GEMINI_MODEL=gemini-1.5-pro
# GEMINI_MODEL=gemini-1.5-flash  # Más rápido y económico

# Anthropic Claude (opcional)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# LLM Provider Activo (openai, gemini, claude)
ACTIVE_LLM_PROVIDER=gemini

# ====================================
# External Services
# ====================================

# Rails REST API
RAILS_API_URL=http://localhost:3000/api/v1
RAILS_API_KEY=                     # Si tu Rails API requiere autenticación

# WebSocket Server (NestJS)
WEBSOCKET_URL=http://localhost:3006
WEBSOCKET_NAMESPACE=/chat

# GraphQL Gateway (opcional, para queries complejas)
GRAPHQL_URL=http://localhost:8000/graphql

# ====================================
# Multimodal Processing
# ====================================

# OCR Configuration
OCR_ENGINE=tesseract              # tesseract | google_vision
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Windows
# TESSERACT_CMD=/usr/bin/tesseract  # Linux/Mac

# Google Cloud Vision (si usas OCR en la nube)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
ALLOWED_PDF_TYPES=pdf

# ====================================
# MCP Tools Configuration
# ====================================

# Tools habilitadas (separadas por coma)
ENABLED_TOOLS=buscar_arquitectos,obtener_proyecto,estadisticas_arquitecto,crear_solicitud,publicar_avance

# Rate Limiting
MAX_REQUESTS_PER_USER_PER_MINUTE=10
MAX_TOOL_EXECUTIONS_PER_REQUEST=5

# ====================================
# Security & Permissions
# ====================================

# Roles permitidos para ejecutar acciones
ALLOWED_ROLES_CREATE=cliente,moderador
ALLOWED_ROLES_READ=cliente,arquitecto,moderador
ALLOWED_ROLES_UPDATE=arquitecto,moderador
ALLOWED_ROLES_DELETE=moderador

# ====================================
# Logging
# ====================================

LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
LOG_FILE=logs/ai-orchestrator.log
LOG_ROTATION=10 MB

# ====================================
# Caching (opcional)
# ====================================

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300             # 5 minutos
