# ==============================================================================
# Variables de Entorno Globales - ArquiPro
# ==============================================================================

# Entorno general
NODE_ENV=development
APP_ENV=development

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arqui_pro_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. Broker de Mensajería (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# 3. Autenticación y Tokens JWT (Compartido entre Auth, Gateway y APIREST)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambiar_por_un_secreto_seguro_y_extenso_en_produccion
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_seguro_para_refresh_tokens
JWT_ISSUER=auth-service
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 4. Puertos y URLs de Microservicios
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=4001
AUTH_SERVICE_URL=http://localhost:4001

GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000

APIREST_PORT=3002
APIREST_URL=http://localhost:3002

WEBSOCKET_PORT=3006
WEBSOCKET_URL=http://localhost:3006

GRAPHQL_PORT=8000
GRAPHQL_URL=http://localhost:8000

AI_ORCHESTRATOR_PORT=8001
AI_ORCHESTRATOR_URL=http://localhost:8001

FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Automatización n8n
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password_seguro
N8N_API_KEY=clave_api_para_comunicacion_interna_con_auth

# ------------------------------------------------------------------------------
# 6. Proveedores de Inteligencia Artificial (AI Orchestrator / MCP)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-tu-clave-openai-aqui
GEMINI_API_KEY=tu-clave-gemini-aqui
