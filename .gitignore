# ==============================================================================
# Git Ignore - Proyecto ArquiPro (Arquitectura Políglota Full Stack)
# ==============================================================================

# Dependencias
node_modules/
*/node_modules/
*/*/node_modules/
*.lock
*.lockb
pnpm-lock.yaml
pnpm-workspace.yaml

# Compilaciones y salidas de empaquetado
dist/
*/dist/
dist-ssr/
build/
*/build/
out/
*/out/
*.tsbuildinfo

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.local
*.pem
*.key
config/master.key
*/config/master.key

# Archivos de depuracion y logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Almacenamiento local y SQLite
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Ruby on Rails
/.bundle
*/.bundle
vendor/bundle/
backend/APIREST/tmp/*
!backend/APIREST/tmp/.keep
backend/APIREST/log/*
!backend/APIREST/log/.keep
backend/APIREST/storage/*
!backend/APIREST/storage/.keep
backend/APIREST/vendor/bundle

# Caches y herramientas de analisis
.npm
.eslintcache
.cache
.parcel-cache
.nyc_output
coverage/
*.lcov

# Editores y Sistemas Operativos
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# MCP y herramientas asistidas
.cursor/
*/.cursor/
.playwright-mcp/
*/.playwright-mcp/